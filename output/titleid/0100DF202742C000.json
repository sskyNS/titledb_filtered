	"intro": "\u9019\u500b\u570b\u5bb6\u7684\u672a\u4f86\u53c8\u5c07\u4f55\u53bb\u4f55\u5f9e\u2014\u2014",
	"description": "\u4e00\u540d\u9053\u58eb\u898b\u7fd2\u5c11\u5973\u300c\u79c0\u9234\u300d\uff0c\u7368\u81ea\u751f\u6d3b\u5728\u6b66\u8853\u76db\u884c\u7684\u570b\u5bb6\u300c\u83ef\u904a\u300d\u3002\n\u4eca\u5e74\u5c07\u8209\u8fa6\u300c\u8c6a\u52c7\u6b66\u8853\u6703\u300d\uff0c\u9078\u51fa\u570b\u5167\u7b2c\u4e00\u5f37\u608d\u7684\u7537\u5b50\uff0c\u9019\u4ee4\u5979\u5341\u5206\u671f\u5f85\u6b66\u8853\u6703\u7684\u5230\u4f86\u3002\n\n\u7136\u800c\u5230\u4e86\u7576\u5929\uff0c\u6703\u5834\u537b\u51fa\u73fe\u4e86\u8972\u64ca\u6c11\u773e\u7684\u8972\u64ca\u8005\u3002\n\n\u5118\u7ba1\u6e96\u6c7a\u8cfd\u7684\u9078\u624b\u5011\u651c\u624b\u4f5c\u6230\uff0c\u66ab\u6642\u5316\u89e3\u4e86\u773c\u524d\u7684\u5371\u6a5f\uff0c\n\u4f46\u9019\u4e0d\u904e\u662f\u6545\u4e8b\u7684\u958b\u7aef\u800c\u5df2\u3002\n\n\u9762\u5c0d\u8207\u5925\u4f34\u9593\u7684\u885d\u7a81\u53ca\u80cc\u53db\u2014\u2014\n\u5118\u7ba1\u53d7\u5230\u632b\u6298\uff0c\u4ed6\u5011\u4ecd\u70ba\u4e86\u5b88\u8b77\u81ea\u5df1\u73cd\u8996\u7684\u4eba\u8207\u81ea\u8eab\u9a55\u50b2\u596e\u9b25\uff0c\n\u800c\u5979\u4e5f\u70ba\u4e86\u6df1\u611b\u7684\u4ed6\u633a\u8eab\u800c\u51fa\uff01\n\n\u4ed6\u5011\u7684\u547d\u904b\u7a76\u7adf\u6703\u5982\u4f55\uff1f\u9019\u500b\u570b\u5bb6\u7684\u672a\u4f86\u53c8\u5c07\u4f55\u53bb\u4f55\u5f9e\u2014\u2014",
