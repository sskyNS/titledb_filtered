	"intro": "\u653e\u8ab2\u5f8c\u306f\u30d0\u30a4\u30c8\u3001\u7d66\u6599\u65e5\u306f\u30ac\u30c1\u30e3\uff01\n\u90e8\u6d3b\u30d2\u30ed\u30a4\u30f3\u30ab\u30fc\u30c9\u3092\u96c6\u3081\u3066\u3001\nUR\u30db\u30ed\u30ab\u30fc\u30c9\u7372\u5f97\u3092\u76ee\u6307\u305d\u3046\uff01",
	"description": "\u300e\u90e8\u6d3b\u30d2\u30ed\u30a4\u30f3\u5b66\u5712\u30ac\u30c1\u30e3\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u300f\u306f\u3001\u30d0\u30a4\u30c8\u3067\u304a\u91d1\u3092\u7a3c\u304e\u3001\u30ac\u30c1\u30e3\u3092\u5f15\u3044\u3066\u30ab\u30fc\u30c9\u3092\u96c6\u3081\u3001\u88ab\u3063\u305f\u30ab\u30fc\u30c9\u3092\u58f2\u308a\u306a\u304c\u3089\u3001UR\u30ab\u30fc\u30c9\u7372\u5f97\u3068\u30b3\u30f3\u30d7\u30ea\u30fc\u30c8\u3092\u76ee\u6307\u3059\u30ac\u30c1\u30e3\uff06\u30ab\u30fc\u30c9\u30b3\u30ec\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\n\u5439\u594f\u697d\u3001\u30d0\u30ec\u30fc\u3001\u30b5\u30c3\u30ab\u30fc\u3001\u30c6\u30cb\u30b9\u3001\u8efd\u97f3\u3001\u66f8\u9053\u3001\u5263\u9053\u3001\u6c34\u6cf3\u3001\u30c1\u30a2\u3001\u5f13\u9053\u3001\u30d0\u30b9\u30b1\u306a\u3069\u3001\u3055\u307e\u3056\u307e\u306a\u90e8\u6d3b\u30d2\u30ed\u30a4\u30f3\u3092\u53ce\u9332\u3002\n\u5236\u670d\u59ff\u306e\u653e\u8ab2\u5f8c\u30d2\u30ed\u30a4\u30f3\u3001\u30e6\u30cb\u30d5\u30a9\u30fc\u30e0\u3067\u6c57\u3092\u6d41\u3059\u904b\u52d5\u90e8\u3001\u697d\u5668\u3084\u7b46\u3092\u624b\u306b\u3057\u305f\u6587\u5316\u90e8\u306a\u3069\u3001\u5b66\u5712\u751f\u6d3b\u306e\u304d\u3089\u3081\u304f\u4e00\u77ac\u3092\u30ab\u30fc\u30c9\u306b\u9589\u3058\u8fbc\u3081\u307e\u3057\u305f\u3002\n\n\u25bc \u30d0\u30a4\u30c8\u3067\u7a3c\u3044\u3067\u30ac\u30c1\u30e3\u3092\u56de\u305d\u3046\n\u307e\u305a\u306f\u30d0\u30a4\u30c8\u3067\u8cc7\u91d1\u3092\u30b2\u30c3\u30c8\u3002\n\u8caf\u3081\u305f\u304a\u91d1\u3067\u30ac\u30c1\u30e3\u3092\u5f15\u304d\u3001\u65b0\u3057\u3044\u30d2\u30ed\u30a4\u30f3\u30ab\u30fc\u30c9\u3092\u96c6\u3081\u307e\u3057\u3087\u3046\u3002\n\n\u300c\u3042\u30681\u56de\u3060\u3051\u2026\u2026\u300d\n\u300c\u6b21\u3053\u305dUR\u304c\u51fa\u308b\u304b\u3082\uff01\u300d\n\u305d\u3093\u306a\u30ac\u30c1\u30e3\u3092\u56de\u3059\u30ef\u30af\u30ef\u30af\u611f\u3092\u3001\u6c17\u8efd\u306b\u4f55\u5ea6\u3067\u3082\u697d\u3057\u3081\u307e\u3059\u3002\n\n\