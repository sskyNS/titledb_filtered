	"intro": "\u500b\u6027\u8c4a\u304b\u306a\u30e2\u30f3\u30bf\u30d3\u3092\u4ef2\u9593\u306b\u3057\u3001\u30c1\u30fc\u30e0\u3092\u4f5c\u308a\u3001\u9032\u5316\u3055\u305b\u3088\u3046\uff01\u30b7\u30ca\u30b8\u30fc\u3092\u6d3b\u304b\u3057\u305f\u30c1\u30fc\u30e0\u3067\u3001\u5f37\u529b\u306a\u30c7\u30c3\u30ad\u3092\u7d44\u307f\u4e0a\u3052\u308d\u3002\u6226\u8853\u7684\u306a\u30b0\u30ea\u30c3\u30c9\u30d0\u30c8\u30eb\u3092\u6975\u3081\u3066\u3001\u8857\u3092\u6551\u3048\uff01",
	"description": "\u30af\u30ea\u30fc\u30c1\u30e3\u30fc\u53ce\u96c6\u578b\u30ed\u30fc\u30b0\u30e9\u30a4\u30af\u30fb\u30c7\u30c3\u30ad\u30d3\u30eb\u30c0\u30fc\u3002\n\n\u30e2\u30f3\u30bf\u30d3\u3092\u96c6\u3081\u3066\u30c1\u30fc\u30e0\u3092\u7de8\u6210\u3057\u3001\u60aa\u515a\u305f\u3061\u3092\u51fa\u3057\u629c\u3044\u3066\u8857\u3092\u6551\u3048\uff01\n\n\u30d2\u30fc\u30ed\u30fc\u306b\u306a\u3063\u3066\u8857\u3092\u6551\u3046\u306a\u3089\u3001\u307e\u305a\u306f\u30e2\u30f3\u30bf\u30d3\u3092\u4ef2\u9593\u306b\u3057\u3088\u3046\uff01 \u30e2\u30f3\u30bf\u30d3\u306f\u305d\u308c\u305e\u308c\u56fa\u6709\u306e\u30b9\u30ad\u30eb\u3092\u6301\u3063\u3066\u304a\u308a\u3001\u7d44\u307f\u5408\u308f\u305b\u6b21\u7b2c\u3067\u7121\u6570\u306e\u30b7\u30ca\u30b8\u30fc\u3092\u751f\u307f\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u3002\u88c5\u5099\u3084\u30c1\u30e3\u30fc\u30e0\u3092\u96c6\u3081\u3066\u6d3b\u7528\u3057\u3001\u52dd\u5229\u3078\u306e\u9053\u3092\u5207\u308a\u958b\u3053\u3046\uff01\n\n\u30e2\u30f3\u30bf\u30d3\u3092\u935b\u3048\u3066\u5f37\u304f\u80b2\u3066\u3001\u65b0\u305f\u306a\u6280\u3092\u7fd2\u5f97\u3055\u305b\u308c\u3070\u3001\u30c1\u30fc\u30e0\u306e\u6226\u7565\u3092\u3055\u3089\u306b\u5f37\u5316\u3067\u304d\u308b\u3002\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3057\u305f\u30e2\u30f3\u30bf\u30d3\u306f\u9032\u5316\u3057\u3001\u3088\u308a\u5f37\u529b\u306a\u59ff\u3068\u306a\u3063\u3066\u65b0\u305f\u306a\u30ab\u30fc\u30c9\u80fd\u529b\u3092\u7372\u5f97\u3059\u308b\u3002\u6226\u8853\u306e\u5e45\u3082\u5927\u304d\u304f\u5e83\u304c\u308b\u305e\u3002\u529b\u3092\u5408\u308f\u305b\u308c\u3070\u3001\u541b\u3068\u30e2\u30f3\u30bf\u30d3\u306b\u4e0d\u53ef\u80fd\u306a\u3093\u3066\u306a\u3044\uff01\n\n\u30e6\u30cb\u30fc\u30af\u306a3\u00d73\u30b0\u30ea\u30c3\u30c9\u30d0\u30c8\u30eb\u3067\u6226\u7565\u3092\u99c6\u4f7f\u3057\u3001\u60aa\u515a\u305f\u3061\u3092\u6253\u3061\u306e\u3081\u305d\u3046\u3002\u30e2\u30f3\u30bf\u30d3\u305f\u3061\u306e\u500b\u6027\u8c4a\u304b\u306a\u80fd\u529b\u3092\u6d3b\u304b\u305b\u3070\u3001\u6226\u7565\u306f\u7121\u9650\u5927\u3060\u3002\u30e9\u30a4\u30d0\u30eb\u305f\u3061\u3092\u51fa\u3057\u629c\u3044\u3066\u52dd\u5229\u3092\u3064\u304b\u3082\u3046\u3002\u305f\u3060\u3057\u3001\u305f\u307e\u306b\u306f\u30ab\u30d5\u30a7\u3067\u4f11\u61a9\u3057\u3066HP\u3092\u56de\u5fa9\u3059\u308b\u3053\u3068\u3082\u304a\u5fd8\u308c\u306a\u304f\uff01\n\n\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306e\u7570\u306a\u308b\u30c8\u30ec\u30fc\u30ca\u30fc\u3092\u9078\u629e\u3057\u3088\u3046\u3002\u4ef2\u9593\u3092\u6709\u5229\u306a\u4f4d\u7f6e\u306b\u914d\u7f6e\u3059\u308b\u306e\u304b\uff1f \u6575\u9663\u306b\u98db\u3073\u8fbc\u3093\u3067\u6226\u3046\u306e\u304b\uff1f \u305d\u308c\u3068\u3082\u3054\u3061\u305d\u3046\u3067\u30e2\u30f3\u30bf\u30d3\u3092\u5f37\u5316\u3059\u308b\u306e\u304b\uff1f \u6226\u7565\u306f\u541b\u6b21\u7b2c\u3002\u8857\u306e\u305f\u3081\u306b\u3001\u307f\u3093\u306a\u3067\u529b\u3092\u5408\u308f\u305b\u3088\u3046\uff01 \u305f\u3060\u3057\u6cb9\u65ad\u306f\u7981\u7269\u3002\u30c1\u30a7\u30b9\u306e\u30ad\u30f3\u30b0\u306e\u3088\u3046\u306b\u3001\u30c8\u30ec\u30fc\u30ca\u30fc\u304c\u5012\u3055\u308c\u308b\u3068\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\u3060\u3002\n\n\u4e3b\u306a\u7279\u5fb4\n\u2022 \u30e2\u30f3\u30bf\u30d3\u30c1\u30fc\u30e0\u3092\u7de8\u6210\u3057\u3088\u3046 \u2014 60\u7a2e\u985e\u4ee5\u4e0a\u306e\u30e2\u30f3\u30bf\u30d3\u3092\u96c6\u3081\u3066\u6226\u3048\uff01\n\u2022 \u9032\u5316\u3057\u3066\u30b9\u30ad\u30eb\u3092\u7372\u5f97 \u2014 \u30e2\u30f3\u30bf\u30d3\u304c\u9032\u5316\u3059\u308b\u305f\u3073\u306b\u3001\u30ec\u30b8\u30a7\u30f3\u30c0\u30ea\u30fc\u80fd\u529b\u30921\u3064\u9078\u307c\u3046\uff01\n\u2022 \u6575\u306e\u88cf\u3092\u304b\u3051 \u2014 3\u00d73\u306e\u30d0\u30c8\u30eb\u30de\u30c3\u30d7\u3067\u6226\u7565\u3092\u6975\u3081\u3088\u3046\uff01\n\u2022 \u30c8\u30ec\u30fc\u30ca\u30fc\u3092\u9078\u307c\u3046 \u2014 \u751f\u5f92\u3001\u30d5\u30a1\u30a4\u30bf\u30fc\u3001\u30b7\u30a7\u30d5\u3002\